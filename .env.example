# Template. Copy to .env and fill in real values. Safe to commit (placeholders only).

# Primary LLM (quarantined reader + planner)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5-5

# Second model for selective double-check (different provider)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=your-openai-model

# Payments (Stripe test mode only, key must start with sk_test_)
STRIPE_SECRET_KEY=sk_test_your-stripe-test-key

# FISCO BCOS anchoring (local Docker node)
FISCO_BCOS_RPC_URL=http://127.0.0.1:20200
FISCO_BCOS_GROUP_ID=group0
FISCO_BCOS_PRIVATE_KEY=your-fisco-bcos-private-key
FISCO_BCOS_CONTRACT_ADDRESS=your-anchor-contract-address

# Local SQLite database
GUARDIAN_DB=guardian.db

# Template. Copy to .env and fill in real values. Safe to commit (placeholders only).

# Google OAuth. Keep real values in .env.local (ignored by Git).
# Google Console origin http://localhost:3000
# Google Console redirect http://localhost:3000/api/auth/callback/google
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Human administrators, comma-separated verified Google email addresses.
# Empty denies all administrator access. Demo sessions never become administrators.
GUARDIAN_ADMIN_EMAILS=
# Hospital discovery uses Google Search grounding, then Groq browser search on failure.
# Uses existing GEMINI_API_KEY and GROQ_API_KEY. No trust is granted by search.
HOSPITAL_SEARCH_MODEL=gemini-3.8-flash

# LLM providers (free tiers). Router in src/server/llm.ts tries models in order
# and skips any that is rate-limited. Optional override:
# LLM_CHAIN=gemini:gemini-3.8-flash,groq:openai/gpt-oss-120b
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Gmail notifications (optional): a Gmail address and a Google app password
# (myaccount.google.com/apppasswords). Payers get an email when a payment request opens.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Payments (Stripe test mode only, key must start with sk_test_)
STRIPE_SECRET_KEY=sk_test_your-stripe-test-key

# FISCO BCOS anchoring (local Docker node)
FISCO_BCOS_RPC_URL=http://127.0.0.1:8545
FISCO_BCOS_CHAIN_ID=20200
FISCO_BCOS_GROUP_ID=group0
FISCO_BCOS_PRIVATE_KEY=printed-by-npm-run-fisco:deploy
FISCO_BCOS_CONTRACT_ADDRESS=printed-by-npm-run-fisco:deploy

# Local SQLite database
GUARDIAN_DB=guardian.db
